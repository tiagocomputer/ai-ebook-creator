# ──────────────────────────────────────────────
# AI eBook Creator — Environment Variables
# ──────────────────────────────────────────────
# Copy this file to .env and fill in your values

# ── AI Provider (pick ONE) ──────────────────────

# Option A: Google Gemini  ← recomendado para começar (gratuito)
GEMINI_API_KEY=AIza...
# GEMINI_MODEL=gemini-2.0-flash   # opcional — padrão: gemini-2.0-flash

# Option B: OpenAI
# OPENAI_API_KEY=sk-...

# Option C: Anthropic Claude
# ANTHROPIC_API_KEY=sk-ant-...

# Option D: OpenAI-compatible endpoint (Ollama, Together, etc.)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=llama3.1

# ── Server ──────────────────────────────────────
PORT=3001
CORS_ORIGIN=http://localhost:3000

# ── Web app ─────────────────────────────────────
# URL of the Express API server (used by Next.js API routes)
API_URL=http://localhost:3001

# Public API URL visible in the browser (for direct SSE streaming)
NEXT_PUBLIC_API_URL=http://localhost:3001
