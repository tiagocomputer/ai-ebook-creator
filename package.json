{
  "name": "ai-ebook-creator",
  "version": "1.0.0",
  "description": "Automated AI-powered eBook generator — title, outline, chapters, PDF/EPUB export",
  "main": "dist/index.js",
  "bin": {
    "ai-ebook-creator": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "ts-node src/index.ts",
    "serve": "ts-node src/server.ts",
    "serve:dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "web": "cd web && npm run dev",
    "start": "node dist/index.js",
    "clean": "rm -rf dist output/*.md output/*.pdf output/*.epub"
  },
  "keywords": [
    "ebook",
    "ai",
    "openai",
    "pdf",
    "epub",
    "generator"
  ],
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@google/generative-ai": "^0.21.0",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "marked": "^14.1.4",
    "openai": "^4.67.0",
    "ora": "^8.1.1",
    "puppeteer": "^23.9.0",
    "slugify": "^1.6.6",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/uuid": "^10.0.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.2"
  }
}
